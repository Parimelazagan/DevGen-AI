# DevGen-AI / Portfolio Generator Environment Variables
# Server Port (default 5000)
PORT=5000

# GitHub Personal Access Token (for fetching GitHub user repositories and project data)
GITHUB_TOKEN=your_github_personal_access_token

# Groq API Key (for LLM portfolio & case study generation)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
